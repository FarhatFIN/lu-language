Lu/Strict

fn fib(n: int) -> int {
    if n <= 1 {
        ret n
    }

    var a: int = 0
    var b: int = 1
    var i: int = 1

    while i < n {
        var next: int = a + b
        set a = b
        set b = next
        set i = i + 1
    }

    ret b
}

fn main() -> int {
    Pr("=== Lu demo: Fibonacci ===")
    var target: int = 8
    var value: int = fib(target)
    Pr("fib(8) = ")
    Pr(value)

    Pr("countdown")
    var countdown: int = 3
    while countdown > 0 {
        Pr(countdown)
        set countdown = countdown - 1
    }
    Pr("done")
    ret 0
}
