Lu/Language

// Core language coverage for the native backend: functions, recursion,
// globals, conditionals and the three loop forms.

var counter: int = 10

fn square(n: int) -> int {
    return n * n
}

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() -> int {
    print(square(7))
    print(fib(10))
    print(counter + 5)

    var a: int = 3
    var b: int = 9
    print(a + b, a * b, b - a)
    print(a < b, a > b, a == 3, a != 3)

    if a < b {
        print("less")
    } else {
        print("not less")
    }

    var i: int = 0
    var acc: int = 0
    while i < 5 {
        acc = acc + i
        i = i + 1
    }
    print(acc)

    var n: int = 0
    loop 4 {
        n = n + 2
    }
    print(n)

    print("line one")
    return 0
}
