Lu/Language

// Signed division and modulo for the native backend. The backend turns
// constant divisors into multiply-high sequences, so the edge cases
// (INT64_MIN, negative divisors, powers of two, large constants) must
// agree with the C backend exactly.

fn main() -> int {
    var a0: int64 = 0
    var a1: int64 = 1
    var a2: int64 = 0 - 1
    var a3: int64 = 7
    var a4: int64 = 0 - 7
    var a5: int64 = 1000003
    var a6: int64 = 1234567890123456789
    var a7: int64 = 0 - 1234567890123456789
    var a8: int64 = 9223372036854775807
    var a9: int64 = -9223372036854775808

    print(a0 / 2, a0 % 2, a0 / 3, a0 % 3, a0 / 7, a0 % 7)
    print(a1 / 2, a1 % 2, a1 / 3, a1 % 3, a1 / 8, a1 % 8)
    print(a2 / 2, a2 % 2, a2 / 3, a2 % 3, a2 / 8, a2 % 8)
    print(a3 / 2, a3 % 2, a3 / 3, a3 % 3, a3 / 7, a3 % 7)
    print(a4 / 2, a4 % 2, a4 / 3, a4 % 3, a4 / 7, a4 % 7)
    print(a5 / 1000, a5 % 1000, a5 / 1024, a5 % 1024, a5 / 1000003, a5 % 1000003)
    print(a6 / 1000, a6 % 1000, a6 / 2147483647, a6 % 2147483647)
    print(a7 / 1000, a7 % 1000, a7 / 2147483647, a7 % 2147483647)
    print(a8 / 2, a8 % 2, a8 / 3, a8 % 3, a8 / 7, a8 % 7)
    print(a8 / 1000003, a8 % 1000003, a8 / 2147483647, a8 % 2147483647)
    print(a9 / 2, a9 % 2, a9 / 3, a9 % 3, a9 / 7, a9 % 7)
    print(a9 / 16, a9 % 16, a9 / 1000, a9 % 1000, a9 / 2147483647, a9 % 2147483647)

    print(a6 / (0 - 2), a6 % (0 - 2), a6 / (0 - 3), a6 % (0 - 3))
    print(a7 / (0 - 2), a7 % (0 - 2), a7 / (0 - 7), a7 % (0 - 7))
    print(a8 / (0 - 3), a8 % (0 - 3), a8 / (0 - 1000003), a8 % (0 - 1000003))
    print(a9 / (0 - 2), a9 % (0 - 2), a9 / (0 - 7), a9 % (0 - 7))
    print(a9 / (0 - 1000), a9 % (0 - 1000), a9 / (0 - 1000003), a9 % (0 - 1000003))

    // Runtime divisors take the idiv path; both must still agree.
    var d: int64 = 3
    var e: int64 = 0 - 1000003
    print(a6 / d, a6 % d, a7 / d, a7 % d)
    print(a8 / e, a8 % e, a9 / e, a9 % e)

    return 0
}
